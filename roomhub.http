### Variables
@baseUrl = http://localhost:5090

### 1. Create room
# @name createRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 1",
  "capacity": 10
}

###
@roomId = {{createRoom.response.body.$.id}}

### 2. Get room
GET {{baseUrl}}/api/rooms/{{roomId}}

### 3. Get a missing room (expected: 404)
GET {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001

### 4. Create booking (change the dates to the future!)
# @name createBooking
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

###
@bookingId = {{createBooking.response.body.$.id}}

### 5. Get booking
GET {{baseUrl}}/api/bookings/{{bookingId}}

### 6. Overlapping booking (expected: 409)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T11:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 4
}

### 7. Cancel booking
POST {{baseUrl}}/api/bookings/{{bookingId}}/cancel

### 8. Add your own requests here for the rules in ASSIGNMENT.md

### Participant daily-limit test: create room 2
# @name createLimitRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 2",
  "capacity": 10
}

###
@limitRoomId = {{createLimitRoom.response.body.$.id}}

### Participant limit: first active booking (expected: 201)
# @name participantFirst
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "participant-limit",
  "startUtc": "2031-02-10T10:00:00Z",
  "endUtc": "2031-02-10T11:00:00Z",
  "attendees": 2
}

###
@participantFirstId = {{participantFirst.response.body.$.id}}

### Participant limit: second active booking in another room (expected: 201)
POST {{baseUrl}}/api/rooms/{{limitRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "participant-limit",
  "startUtc": "2031-02-10T12:00:00Z",
  "endUtc": "2031-02-10T13:00:00Z",
  "attendees": 2
}

### Participant limit: third active booking on the same UTC day (expected: 409)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "participant-limit",
  "startUtc": "2031-02-10T14:00:00Z",
  "endUtc": "2031-02-10T15:00:00Z",
  "attendees": 2
}

### Participant limit: cancel one active booking
POST {{baseUrl}}/api/bookings/{{participantFirstId}}/cancel

### Participant limit: cancelled booking frees the slot (expected: 201)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "participant-limit",
  "startUtc": "2031-02-10T14:00:00Z",
  "endUtc": "2031-02-10T15:00:00Z",
  "attendees": 2
}

### Participant limit: another UTC day is independent (expected: 201)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "participant-limit",
  "startUtc": "2031-02-11T10:00:00Z",
  "endUtc": "2031-02-11T11:00:00Z",
  "attendees": 2
}

### R1-R4 validation: missing room (expected 404 before validation)
POST {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000002/bookings
Content-Type: application/json

{
  "bookedBy": "",
  "startUtc": "2032-01-01T10:00:00Z",
  "endUtc": "2032-01-01T09:00:00Z",
  "attendees": 0
}

### R10: capacity > 10 exact 2h allowed
# @name largeRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Large room",
  "capacity": 11
}

###
@largeRoomId = {{largeRoom.response.body.$.id}}

POST {{baseUrl}}/api/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "duration-limit",
  "startUtc": "2032-03-10T10:00:00Z",
  "endUtc": "2032-03-10T12:00:00Z",
  "attendees": 11
}

### R10: capacity > 10 exceeding 2h (expected 400)
POST {{baseUrl}}/api/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "duration-limit",
  "startUtc": "2032-03-10T13:00:00Z",
  "endUtc": "2032-03-10T15:01:00Z",
  "attendees": 11
}

### R10: capacity <= 10 exact 4h allowed
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "small-room-limit",
  "startUtc": "2032-04-10T10:00:00Z",
  "endUtc": "2032-04-10T14:00:00Z",
  "attendees": 10
}

### R10: capacity <= 10 exceeding 4h (expected 400)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "small-room-limit",
  "startUtc": "2032-04-11T10:00:00Z",
  "endUtc": "2032-04-11T14:01:00Z",
  "attendees": 10
}

### R7: touching intervals allowed
# @name touchingFirst
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "touching-a",
  "startUtc": "2032-05-10T10:00:00Z",
  "endUtc": "2032-05-10T11:00:00Z",
  "attendees": 2
}

POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "touching-b",
  "startUtc": "2032-05-10T11:00:00Z",
  "endUtc": "2032-05-10T12:00:00Z",
  "attendees": 2
}

