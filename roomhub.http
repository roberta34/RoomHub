  "startUtc": "2032-06-10T12:00:00Z",
  "endUtc": "2032-06-10T13:00:00Z",
  "attendees": 2
}

### R9: third active booking on same UTC day (expected 409)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "r9-participant",
  "startUtc": "2032-06-10T14:00:00Z",
  "endUtc": "2032-06-10T15:00:00Z",
